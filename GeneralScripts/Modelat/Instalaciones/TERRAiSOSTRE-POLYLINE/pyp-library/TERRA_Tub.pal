                <Text>Llargada</Text>
                <Value>1000.0</Value>
                <MinValue>0</MinValue>
                <ValueType>Length</ValueType>
                <Visible>False</Visible>
            </Parameter>
            <Parameter>
                <Name>BarraGruix</Name>
                <Text>Gruix</Text>
                <Value>1.5</Value>
                <MinValue>0</MinValue>
                <ValueType>Length</ValueType>
                <Visible>SelectorTipusTub == 'Tub' or SelectorTerraSostre == "TERRA"</Visible>
