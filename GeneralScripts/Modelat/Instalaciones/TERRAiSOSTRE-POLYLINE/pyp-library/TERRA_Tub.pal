<?xml version="1.0" encoding="utf-8"?>
<Element>
    <Script>
        <Title>Tub de Terra i Sostre</Title>
    </Script>
    <Page>
        <Name>Page1</Name>
        <Text>Dades Generals</Text>


        <Parameter>
            <Name>DimensionsParameterExpander</Name>
