    <Parameter>
        <Name>ExtensioInferior</Name>
        <Text>ExtensioInferior</Text>
        <ValueType>Expander</ValueType>
        <ExcludeIdentical>False</ExcludeIdentical>
        <Visible>SelectorPPEN == 1 and SelectorENH == 'EN Inferior'</Visible>

